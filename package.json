{
  "name": "public-infrastructure-maintenance-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "公開インフラ維持管理マップ — 公開情報からインフラ調査の入口を提供する Web GIS",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/db/migrate.mjs",
    "ingest": "pnpm --filter @pimm/api ingest",
    "ingest:w05:all": "node scripts/tools/ingest-river-w05-all.mjs",
    "ratelimit:cloudflare": "node scripts/tools/cloudflare-rate-limit.mjs",
    "smoke:cloudflare": "node scripts/tools/cloudflare-production-smoke.mjs",
    "smoke:cloudflare:pending": "node scripts/tools/cloudflare-production-smoke.mjs --allow-pending-dns",
    "smoke:cloudflare:preflight": "node scripts/tools/cloudflare-production-smoke.mjs --allow-pending-dns --skip-wrangler"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.1.7": "1.1.18",
      "js-yaml": "^4.3.1",
      "nanoid@^3.3.16": "3.3.18",
      "postcss": "8.5.25"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "postgres": "^3.4.7",
    "prettier": "^3.6.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
