# ============================================================
# Public Infrastructure Maintenance Map — environment template
# Copy to .env.local and fill in real values.
# .env / .env.local are NEVER committed to Git.
# ============================================================

# --- Public values (safe to expose to the browser) ---
# Vite only exposes variables prefixed with VITE_ to the client bundle
# (apps/web reads import.meta.env.VITE_API_BASE_URL). The name must keep the
# VITE_ prefix or the web app silently falls back to the same-origin '/api/v1'.
VITE_API_BASE_URL=http://localhost:8787/api/v1

# --- Secrets (store in Cloudflare/GitHub secret managers in CI/prod) ---
# Neon PostgreSQL connection string (PostGIS enabled).
# Absent → the API serves bundled fictional SAMPLE data (local-dev default).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Set to true in production so a missing DATABASE_URL fails loudly instead of
# silently falling back to sample data. Leave unset for local sample-mode dev.
REQUIRE_DATABASE_URL=

# Cloudflare Access application audience (AUD) tag, and the Access team
# hostname that publishes the signing keys (e.g. example.cloudflareaccess.com).
# Setting either one turns on JWT enforcement for the admin API: the Worker
# verifies Cf-Access-Jwt-Assertion itself and takes the caller's identity from
# the signed claim, ignoring CF-Access-Authenticated-User-Email. Leave both
# unset for local development, where no Access deployment issues tokens.
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=

# Force the above enforcement even before the AUD/team domain are filled in, so
# a half-configured production deployment rejects admin requests (503) instead
# of falling back to the spoofable header. Set to true in production.
REQUIRE_ACCESS_JWT=

# Admin API role allowlists. Access authenticates the user; the API grants
# write/review permissions only when the authenticated email is listed here.
# Comma-separated, lowercase recommended.
ADMIN_EMAILS=admin@example.com
REVIEWER_EMAILS=reviewer@example.com
