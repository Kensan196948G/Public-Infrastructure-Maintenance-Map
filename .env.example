# ============================================================
# Public Infrastructure Maintenance Map — environment template
# Copy to .env.local and fill in real values.
# .env / .env.local are NEVER committed to Git.
# ============================================================

# --- Public values (safe to expose to the browser) ---
PUBLIC_API_BASE_URL=http://localhost:8787/api/v1

# --- Secrets (store in Cloudflare/GitHub secret managers in CI/prod) ---
# Neon PostgreSQL connection string (PostGIS enabled).
# Absent → the API serves bundled fictional SAMPLE data (local-dev default).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Set to true in production so a missing DATABASE_URL fails loudly instead of
# silently falling back to sample data. Leave unset for local sample-mode dev.
REQUIRE_DATABASE_URL=

# Cloudflare Access audience tag for admin API authentication
CLOUDFLARE_ACCESS_AUD=
