{
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(node --version:*)",
      "Bash(npm --version:*)",
      "Bash(claude --version:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Test-Path:*)",
      "PowerShell(Get-Command:*)",
      "Bash(npx wrangler whoami:*)",
      "Bash(npx wrangler --version:*)",
      "Bash(npx wrangler deployments list:*)",
      "Bash(npx wrangler versions list:*)",
      "Bash(npx wrangler secret list:*)",
      "Bash(npx wrangler kv namespace list:*)",
      "Bash(npx wrangler d1 list:*)",
      "Bash(npx wrangler r2 bucket list:*)",
      "Bash(npx wrangler pages project list:*)",
      "mcp__plugin_cloudflare_cloudflare-api__search",
      "mcp__plugin_cloudflare_cloudflare-api__docs",
      "mcp__plugin_cloudflare_cloudflare-docs__search_cloudflare_documentation",
      "mcp__plugin_cloudflare_cloudflare-docs__migrate_pages_to_workers_guide",
      "mcp__plugin_cloudflare_cloudflare-bindings__workers_list",
      "mcp__plugin_cloudflare_cloudflare-bindings__workers_get_worker",
      "mcp__plugin_cloudflare_cloudflare-bindings__workers_get_worker_code",
      "mcp__plugin_cloudflare_cloudflare-bindings__kv_namespaces_list",
      "mcp__plugin_cloudflare_cloudflare-bindings__kv_namespace_get",
      "mcp__plugin_cloudflare_cloudflare-bindings__r2_buckets_list",
      "mcp__plugin_cloudflare_cloudflare-bindings__r2_bucket_get",
      "mcp__plugin_cloudflare_cloudflare-bindings__d1_databases_list",
      "mcp__plugin_cloudflare_cloudflare-bindings__d1_database_get",
      "mcp__plugin_cloudflare_cloudflare-bindings__hyperdrive_configs_list",
      "mcp__plugin_cloudflare_cloudflare-bindings__hyperdrive_config_get",
      "mcp__plugin_cloudflare_cloudflare-bindings__search_cloudflare_documentation",
      "mcp__plugin_cloudflare_cloudflare-builds__workers_builds_list_builds",
      "mcp__plugin_cloudflare_cloudflare-builds__workers_builds_get_build",
      "mcp__plugin_cloudflare_cloudflare-builds__workers_builds_get_build_logs",
      "mcp__plugin_cloudflare_cloudflare-builds__workers_list",
      "mcp__plugin_cloudflare_cloudflare-builds__workers_get_worker",
      "mcp__plugin_cloudflare_cloudflare-builds__workers_get_worker_code",
      "mcp__plugin_cloudflare_cloudflare-observability__query_worker_observability",
      "mcp__plugin_cloudflare_cloudflare-observability__observability_keys",
      "mcp__plugin_cloudflare_cloudflare-observability__observability_values",
      "mcp__plugin_cloudflare_cloudflare-observability__workers_list",
      "mcp__plugin_cloudflare_cloudflare-observability__workers_get_worker",
      "mcp__plugin_cloudflare_cloudflare-observability__workers_get_worker_code",
      "mcp__plugin_cloudflare_cloudflare-observability__search_cloudflare_documentation",
      "mcp__plugin_neon_neon__list_projects",
      "mcp__plugin_neon_neon__list_shared_projects",
      "mcp__plugin_neon_neon__list_organizations",
      "mcp__plugin_neon_neon__describe_project",
      "mcp__plugin_neon_neon__describe_branch",
      "mcp__plugin_neon_neon__list_branch_computes",
      "mcp__plugin_neon_neon__get_database_tables",
      "mcp__plugin_neon_neon__describe_table_schema",
      "mcp__plugin_neon_neon__compare_database_schema",
      "mcp__plugin_neon_neon__explain_sql_statement",
      "mcp__plugin_neon_neon__list_slow_queries",
      "mcp__plugin_neon_neon__query_logs",
      "mcp__plugin_neon_neon__list_log_fields",
      "mcp__plugin_neon_neon__list_log_field_values",
      "mcp__plugin_neon_neon__list_docs_resources",
      "mcp__plugin_neon_neon__get_doc_resource",
      "mcp__plugin_neon_neon__search",
      "mcp__plugin_neon_neon__fetch"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin:*)",
      "Bash(git clean -fdx:*)",
      "PowerShell(Remove-Item -Recurse -Force:*)",
      "PowerShell(Remove-Item -Force -Recurse:*)"
    ]
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "true",
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "includeCoAuthoredBy": true,
  "outputStyle": "Explanatory-Icons",
  "statusLine": {
    "type": "command",
    "command": "python .claude/statusline.py"
  },
  "language": "日本語",
  "spinnerTipsEnabled": true,
  "alwaysThinkingEnabled": true,
  "promptSuggestionEnabled": true,
  "autoUpdatesChannel": "latest",
  "prefersReducedMotion": false,
  "fallbackModel": [
    "claude-opus-4-8",
    "claude-sonnet-4-6",
    "claude-haiku-4-5"
  ],
  "terminal": {
    "mode": "auto"
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/claudeos/scripts/hooks/pre-commit-gate.js\"",
            "continueOnBlock": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/claudeos/scripts/hooks/pre-compact.js\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/claudeos/scripts/hooks/session-start.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/claudeos/scripts/hooks/session-end.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/claudeos/scripts/hooks/usage-tracker.js\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/claudeos/scripts/hooks/agent-transcript.js\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/claudeos/scripts/hooks/auto-format.js\"",
            "continueOnBlock": true
          }
        ]
      },
      {
        "matcher": "TeamCreate",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/claudeos/scripts/hooks/agent-teams-tracker.js\""
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/claudeos/scripts/hooks/agent-teams-tracker.js\""
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/claudeos/scripts/hooks/teammate-idle-gate.js\""
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/claudeos/scripts/hooks/task-created-gate.js\""
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/claudeos/scripts/hooks/task-completed-gate.js\""
          }
        ]
      }
    ]
  }
}
