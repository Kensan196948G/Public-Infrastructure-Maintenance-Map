{
  "$schema": "https://opencode.ai/config.json",

  "model": "openrouter/glm/glm-5.2",
  "small_model": "openrouter/openai/gpt-5.6-luna",

  "provider": {
    "openrouter": {
      "models": {
        "glm/glm-5.2":             { "name": "GLM 5.2" },
        "openai/gpt-5.6-luna":     { "name": "ChatGPT 5.6 Luna" },
        "deepseek/deepseek-v4-pro":{ "name": "DeepSeek V4 Pro" },
        "nvidia/kimi-k3":          { "name": "Kimi K3" }
      }
    }
  },

  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },

  "default_agent": "build",

  "instructions": [
    "~/.config/opencode/instructions/japanese-ui.md"
  ],

  "agent": {
    "build": {
      "mode": "primary",
      "description": "GLM 5.2 による標準開発",
      "model": "openrouter/glm/glm-5.2",
      "temperature": 0.2,
      "max_steps": 20
    },

    "monitor": {
      "mode": "primary",
      "description": "Monitor: ログ・差分・現状整理（軽量）",
      "model": "openrouter/openai/gpt-5.6-luna",
      "temperature": 0.1,
      "max_steps": 8
    },

    "verify": {
      "mode": "primary",
      "description": "Verify: テスト結果確認・差分レビュー",
      "model": "openrouter/openai/gpt-5.6-luna",
      "temperature": 0.0,
      "max_steps": 12
    },

    "development": {
      "mode": "primary",
      "description": "Development: 難しめの実装・リファクタ",
      "model": "openrouter/deepseek/deepseek-v4-pro",
      "temperature": 0.1,
      "max_steps": 20
    },

    "improvement": {
      "mode": "primary",
      "description": "Improvement: 方針・設計レビュー・次サイクル計画",
      "model": "openrouter/nvidia/kimi-k3",
      "temperature": 0.3,
      "max_steps": 14
    }
  }
}
